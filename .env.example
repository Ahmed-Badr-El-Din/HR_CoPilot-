# ---------------------------------------------------------------------------
# HR Copilot (D6T1) — environment variable template
#
# The application does NOT read this file; it reads environment variables and
# appsettings.json. Copy the variables you need into your shell/compose file.
# Never commit real secrets.
#
# Real option sections: Llm, Storage, Auth, Ingestion, RateLimit
# (see HR.Infrastructure/Providers/Options.cs). Env form uses `__` separators
# exactly as written below.
# ---------------------------------------------------------------------------

# --- Host / runtime ---------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://*:8000

# --- Storage ----------------------------------------------------------------
# Dev default keeps a local SQLite file created in the working directory.
# Postgres is the documented production target; connection string is the only
# change needed behind the EF migration layer.
Storage__ConnectionString=Data Source=hr.db

# --- LLM providers ----------------------------------------------------------
# Comma-separated ordered chain; the first provider that succeeds wins.
# "local" is deterministic/offline and needs NO key (CI/demo/eval default).
Llm__FallbackOrder=local
# Or, when a hosted tier is available:
# Llm__FallbackOrder=openai,local
Llm__ApiKey=
Llm__BaseUrl=https://api.openai.com/v1
Llm__ChatModel=gpt-4o-mini
Llm__EmbeddingModel=text-embedding-3-small
Llm__PricingPer1MInput=0.15
Llm__PricingPer1MOutput=0.60
Llm__TimeoutSeconds=90
Llm__MaxRetries=2
Llm__RetryBackoffBaseMs=250

# --- JWT / auth -------------------------------------------------------------
# Generate a real dev secret:  openssl rand -hex 32
Auth__JwtSigningKey=CHANGE_ME___dev_only___at_least_32_chars_with_entropy
Auth__JwtIssuer=hr-copilot
Auth__JwtAudience=hr-copilot-clients
Auth__TokenLifetimeHours=12
Auth__DefaultAdminEmail=admin@hr.local
Auth__DefaultAdminPassword=ChangeMe1!
Auth__DefaultManagerEmail=manager@hr.local
Auth__DefaultManagerPassword=ChangeMe1!
Auth__DefaultAuditorEmail=auditor@hr.local
Auth__DefaultAuditorPassword=ChangeMe1!

# --- Ingestion ----------------------------------------------------------------
Ingestion__MaxFileBytes=26214400
Ingestion__ChunkMaxCharacters=1400
Ingestion__SeedCorpusOnStartup=true

# --- Rate limiting (in-process token bucket, per client) ----------------------
RateLimit__TokensPerMinute=120
RateLimit__Burst=40