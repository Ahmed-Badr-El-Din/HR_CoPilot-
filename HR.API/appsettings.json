{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "ChatModel": "gpt-4o-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "PricingPer1MInput": 0.15,
    "PricingPer1MOutput": 0.60,
    "TimeoutSeconds": 90,
    "MaxRetries": 2,
    "FallbackOrder": "local"
  },
  "Storage": {
    "ConnectionString": "Data Source=hr.db"
  },
  "Auth": {
    "JwtIssuer": "hr-copilot",
    "JwtAudience": "hr-copilot-clients",
    "JwtSigningKey": "CHANGE_ME___dev_only___at_least_32_chars_with_entropy",
    "TokenLifetimeHours": 12,
    "DefaultAdminEmail": "admin@hr.local",
    "DefaultAdminPassword": "ChangeMe1!",
    "DefaultManagerEmail": "manager@hr.local",
    "DefaultManagerPassword": "ChangeMe1!",
    "DefaultAuditorEmail": "auditor@hr.local",
    "DefaultAuditorPassword": "ChangeMe1!"
  },
  "Ingestion": {
    "MaxFileBytes": 26214400,
    "ChunkMaxCharacters": 1400,
    "SeedCorpusOnStartup": true
  },
  "RateLimit": {
    "TokensPerMinute": 120,
    "Burst": 40
  }
}