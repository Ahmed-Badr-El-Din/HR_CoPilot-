<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>HR.Infrastructure</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisLevel>latest</AnalysisLevel>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Prompts/assets/*.json"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HR.Application\HR.Application.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.7"/>
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.7"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.7"/>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.7"/>
        <!-- SQLitePCLRaw 2.1.11 carries GHSA-2m69-gcr7-jv3q (high); 2.1.13 is patched. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13"/>
        <!-- Only a prerelease mirror of PdfPig exists on nuget.org; the MIT fork is fine for
             reading text out of our synthetic PDFs. This is value extraction, not rendering. -->
        <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>